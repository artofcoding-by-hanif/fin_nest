{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Development",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--dart-define=FLAVOR=development"
      ]
    },
    {
      "name": "Staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": [
        "--dart-define=FLAVOR=staging"
      ]
    },
    {
      "name": "Production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=FLAVOR=production"
      ]
    },
    {
      "name": "Development (Profile Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "flutterMode": "profile",
      "args": [
        "--dart-define=FLAVOR=development"
      ]
    },
    {
      "name": "Production (Release Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": [
        "--dart-define=FLAVOR=production"
      ]
    }
  ]
}

