rules_version = '2';

// The app never talks to Firestore directly. Only the Cloud Functions (which
// bypass these rules through the Admin SDK) read and write AI usage counters
// and AI-content reports. FinNest's financial data lives on the device only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
